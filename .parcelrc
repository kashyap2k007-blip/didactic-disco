{
  "extends": "@parcel/config-default",
  "resolvers": ["@parcel/resolver-default"],
  "transformers": {
    "*.{js,mjs,jsx,cjs,ts,tsx}": ["@parcel/transformer-js"],
    "*.{css,scss}": ["@parcel/transformer-css"],
    "*.{html}": ["@parcel/transformer-html"]
  },
  "optimizers": {
    "*.{js,mjs,jsx,cjs,ts,tsx}": ["@parcel/optimizer-terser"],
    "*.{css,scss}": ["@parcel/optimizer-css"],
    "*.{html}": ["@parcel/optimizer-htmlnano"]
  },
  "reporters": ["@parcel/reporter-cli"],
  "namers": ["@parcel/namer-default"]
}